{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build JammaLib (Debug x64)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& \"${workspaceFolder}\\.github\\skills\\builder\\builder.ps1\" -Target JammaLib -Configuration Debug -Platform x64"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Jamma (Debug x64)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& \"${workspaceFolder}\\.github\\skills\\builder\\builder.ps1\" -Target Jamma -Configuration Debug -Platform x64"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build JammaLib_Tests (Debug x64)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& \"${workspaceFolder}\\.github\\skills\\builder\\builder.ps1\" -Target JammaLib_Tests -Configuration Debug -Platform x64"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run JammaLib_Tests",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& \"${workspaceFolder}\\test\\JammaLib_Tests\\bin\\x64\\Debug\\JammaLib_Tests.exe\""
      ],
      "dependsOn": "Build JammaLib_Tests (Debug x64)",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Run JammaLib_Tests (filtered)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& \"${workspaceFolder}\\test\\JammaLib_Tests\\bin\\x64\\Debug\\JammaLib_Tests.exe\" --gtest_filter=\"${input:gtestFilter}\""
      ],
      "dependsOn": "Build JammaLib_Tests (Debug x64)",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Build Solution (Debug x64)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& \"${workspaceFolder}\\.github\\skills\\builder\\builder.ps1\" -Target Solution -Configuration Debug -Platform x64"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    }
  ],
  "inputs": [
    {
      "id": "gtestFilter",
      "type": "promptString",
      "description": "GoogleTest filter, for example StationTests.*",
      "default": "SuiteName.TestName"
    }
  ]
}
